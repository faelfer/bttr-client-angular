{
  "name": "bttr-client-angular",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0 <23 || >=24.0.0"
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest --runInBand",
    "test-unit": "npm test",
    "test:coverage": "jest --runInBand --coverage",
    "test-unit-coverage": "npm run test:coverage",
    "test:e2e": "playwright test",
    "test-e2e": "npm run test:e2e",
    "test:e2e:security": "playwright test e2e/security.spec.ts",
    "test:e2e:report": "playwright show-report",
    "test:lighthouse": "lhci autorun",
    "test:lighthouse:ci": "npm run build && npm run test:lighthouse && node scripts/lighthouse-benchmark.mjs",
    "lint": "npm run lint:code && npm run lint:styles",
    "lint:code": "eslint .",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "lint:fix": "npm run lint:code -- --fix && npm run lint:styles -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:audit": "sh security/npm-audit.sh",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage -- --ci",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@primeuix/themes": "^2.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^9.39.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "angular-eslint": "^21.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-preset-angular": "^17.0.0",
    "prettier": "^3.8.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "overrides": {
    "@lhci/cli": {
      "lighthouse": "13.5.0",
      "uuid": "11.1.1"
    },
    "@lhci/utils": {
      "lighthouse": "13.5.0"
    },
    "tmp": "0.2.7"
  }
}
